/** JANNATUL BAQI LOCATION REGISTRY DATA — source: Bangladesh_Master_Location_Database.xlsx */
const LOCATION_REGISTRY_VERSION_ = '2026-08-21';
const LOCATION_REGISTRY_B64_1_ = '';
const LOCATION_REGISTRY_B64_2_ = '';

function installLocationRegistry_(ss) {
  const sh = ss.getSheetByName(SHEETS.LOCATION_MASTER);
  if (!sh) return;
  const current = String(getConfigValue_('LOCATION_MASTER_VERSION') || '');
  if (current === LOCATION_REGISTRY_VERSION_ && sh.getLastRow() > 40000) return;
  const b64 = LOCATION_REGISTRY_B64_1_ + LOCATION_REGISTRY_B64_2_;
  const bytes = Utilities.base64Decode(b64);
  const text = Utilities.ungzip(Utilities.newBlob(bytes, 'application/gzip')).getDataAsString('UTF-8');
  const x = JSON.parse(text);
  const divs=x[0], dists=x[1], ups=x[2], uns=x[3];
  const out=[];
  for (let i=0;i<uns.length;i++) {
    const up=ups[uns[i][0]], dist=dists[up[0]];
    const row=[divs[dist[0]],dist[1],up[1],uns[i][1]];
    for(let w=1;w<=9;w++) out.push(row.concat([w+' নং ওয়ার্ড','','']));
  }
  const old=sh.getLastRow();
  if(old>1) sh.getRange(2,1,old-1,7).clearContent();
  if(out.length) {
    for(let s=0;s<out.length;s+=5000){
      const n=Math.min(5000,out.length-s);
      sh.getRange(s+2,1,n,7).setValues(out.slice(s,s+n));
    }
  }
  setConfigValue_('LOCATION_MASTER_VERSION',LOCATION_REGISTRY_VERSION_);
}
function getConfigValue_(key){
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.CONFIG);
  if(!sh||sh.getLastRow()<2)return '';
  const v=sh.getDataRange().getValues();
  for(let i=1;i<v.length;i++) if(String(v[i][0])===String(key)) return v[i][1];
  return '';
}
function setConfigValue_(key,value){
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.CONFIG);
  if(!sh)return;
  const v=sh.getDataRange().getValues();
  for(let i=1;i<v.length;i++){
    if(String(v[i][0])===String(key)){sh.getRange(i+1,2).setValue(value);sh.getRange(i+1,3).setValue(now_());return;}
  }
  sh.appendRow([key,value,now_()]);
}